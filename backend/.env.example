# Copie para backend/.env. NUNCA versione o .env.
# Os testes de integração reutilizam DB_HOST/DB_PORT/DB_USER/DB_PASSWORD,
# mas forçam DB_NAME=onepulse_test (veja vitest.config.ts).
NODE_ENV=development
PORT=3333

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=onepulse
DB_PASSWORD=change_me
DB_NAME=onepulse_db

# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_random_string_with_at_least_32_chars
JWT_EXPIRES_IN_SECONDS=28800
BCRYPT_ROUNDS=12

CORS_ORIGIN=http://localhost:5173
